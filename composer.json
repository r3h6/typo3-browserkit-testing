{
	"name": "r3h6/typo3-browserkit-testing",
	"description": "BrowserKit testing for TYPO3",
	"require": {
		"php": ">=8.2",
		"symfony/browser-kit": "*",
		"symfony/css-selector": "*",
		"symfony/http-client-contracts": "^3.6",
		"symfony/process": "*",
		"typo3/testing-framework": "^8.2"
	},
	"license": "MIT",
	"autoload": {
		"psr-4": {
			"R3H6\\Typo3BrowserkitTesting\\": "src/",
			"R3H6\\WebTestCase\\": "res/Extension/web_test_case/Classes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"R3H6\\Typo3BrowserkitTesting\\Tests\\": "tests/"
		}
	},
	"config": {
		"vendor-dir": ".Build/vendor",
		"bin-dir": ".Build/bin",
		"lock": false,
		"sort-packages": true,
		"allow-plugins": {
			"typo3/cms-composer-installers": true,
			"typo3/class-alias-loader": true
		}
	},
	"scripts": {
		"ci:php:lint": "find *.php src/ res/ tests/ -name '*.php' -print0 | xargs -0 -n 1 -P 4 php -l",
		"ci:php:cs": "PHP_CS_FIXER_IGNORE_ENV=1 php-cs-fixer fix --config .php-cs-fixer.php -v --dry-run --using-cache no --diff",
		"fix:php:cs": "PHP_CS_FIXER_IGNORE_ENV=1 php-cs-fixer fix --config .php-cs-fixer.php",
		"ci:php:stan": "phpstan analyse",
		"fix:php:stan": "phpstan analyse --generate-baseline"
	},
	"extra": {
		"typo3/cms": {
			"web-dir": ".Build/public"
		}
	},
	"repositories": [
		{
			"type": "path",
			"url": "res/Extension/*"
		},
		{
			"type": "composer",
			"url": "https://composer.typo3.org/"
		}
	],
	"require-dev": {
		"blastcloud/guzzler": "^2.0",
		"r3h6/typo3-example-extension": "@dev",
		"saschaegerer/phpstan-typo3": "^1.10 || ^2.0",
		"typo3/cms-backend": "^12.4 || ^13.4",
		"typo3/cms-core": "^12.4 || ^13.4",
		"typo3/cms-extensionmanager": "^12.4 || ^13.4",
		"typo3/cms-felogin": "^12.4 || ^13.4",
		"typo3/cms-filelist": "^12.4 || ^13.4",
		"typo3/cms-fluid-styled-content": "^12.4 || ^13.4",
		"typo3/cms-form": "^12.4 || ^13.4",
		"typo3/cms-install": "^12.4 || ^13.4",
		"typo3/cms-lowlevel": "^12.4 || ^13.4",
		"typo3/cms-reports": "^12.4 || ^13.4",
		"typo3/coding-standards": "^0.7 || ^0.8"
	},
	"suggest": {
		"blastcloud/guzzler": "Supercharge your app with a testing library specifically for Guzzle"
	}
}
