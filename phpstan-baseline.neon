parameters:
	ignoreErrors:
		-
			message: "#^Method PHPUnit\\\\Framework\\\\ExpectationFailedException\\:\\:__construct\\(\\) invoked with 4 parameters, 1\\-3 required\\.$#"
			count: 1
			path: src/WebTestCase.php

		-
			message: "#^Method R3H6\\\\Typo3BrowserkitTesting\\\\WebTestCase\\:\\:getClient\\(\\) has parameter \\$newClient with generic class Symfony\\\\Component\\\\BrowserKit\\\\AbstractBrowser but does not specify its types\\: TRequest, TResponse$#"
			count: 1
			path: src/WebTestCase.php

		-
			message: "#^Method R3H6\\\\Typo3BrowserkitTesting\\\\WebTestCase\\:\\:getClient\\(\\) return type with generic class Symfony\\\\Component\\\\BrowserKit\\\\AbstractBrowser does not specify its types\\: TRequest, TResponse$#"
			count: 1
			path: src/WebTestCase.php

		-
			message: "#^Method R3H6\\\\Typo3BrowserkitTesting\\\\WebTestCase\\:\\:getRequest\\(\\) should return Symfony\\\\Component\\\\HttpFoundation\\\\Request but returns Symfony\\\\Component\\\\BrowserKit\\\\Request\\.$#"
			count: 1
			path: src/WebTestCase.php

		-
			message: "#^Negated boolean expression is always false\\.$#"
			count: 2
			path: src/WebTestCase.php

		-
			message: "#^Parameter \\#5 \\$line of class ErrorException constructor expects int\\|null, string given\\.$#"
			count: 1
			path: src/WebTestCase.php
